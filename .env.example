PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/kindred_fmr
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
# Gmail SMTP with OAuth2 (recommended) or an App Password.
# If credentials are not configured, development verification/reset links are logged.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Set SMTP_AUTH=oauth2 and fill in all three GOOGLE_* values to use Google OAuth2.
# The refresh token must grant the https://mail.google.com/ scope.
SMTP_AUTH=password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# For password authentication, use a 16-character Google App Password, not your regular password.
SMTP_PASS=
EMAIL_FROM=
# Escalation email uses these SMTP settings and the verified caregiver account email.
